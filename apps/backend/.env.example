# Azure Workflow Backend — Environment Variables
# Copy this file to .env and fill in values

# Server
PORT=4000
NODE_ENV=development

# API Key Authentication
# All requests must include header: x-api-key: <value>
API_KEY=dev-secret-key-change-in-production

# Mock Mode (always true for local dev)
MOCK_MODE=true

# Socket.IO real-time vitals simulation interval (ms)
SIMULATION_INTERVAL_MS=5000

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Azure Services (unused when MOCK_MODE=true) ---
# AZURE_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# AZURE_COSMOS_KEY=
# AZURE_COSMOS_DB_NAME=elderly-care-db

# AZURE_IOT_HUB_CONNECTION_STRING=
# AZURE_SERVICE_BUS_CONNECTION_STRING=
# AZURE_STORAGE_CONNECTION_STRING=

# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
